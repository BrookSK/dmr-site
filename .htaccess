RewriteEngine On

# Servir assets diretamente do /public
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
RewriteRule ^import\.png$ public/import.png [L]
RewriteRule ^favicon\.ico$ public/favicon.ico [L]
RewriteRule ^cron-notifications\.php$ public/cron-notifications.php [L]
RewriteRule ^cron\.php$ public/cron.php [L]

# Se o arquivo ou diretório existir na raiz, entrega direto
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Caso contrário, envia tudo para o front controller em /public com a URL
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]

# Aumentar limite de upload para 500MB
php_value upload_max_filesize 500M
php_value post_max_size 512M
php_value max_execution_time 600
php_value max_input_time 600

# ===========================================================================
# Otimizações de performance e segurança
# (acrescentadas ao padrão base; não alteram as regras de rewrite acima)
# ===========================================================================

# --- Compressão GZIP -------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject font/ttf font/otf font/woff font/woff2
</IfModule>

# --- Cache de navegador (Expires) ------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    ExpiresDefault "access plus 1 week"
</IfModule>

# --- Cache-Control para assets estáticos -----------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|woff2?|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Headers de segurança (reforço ao que a aplicação já envia)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# --- Proteção de arquivos sensíveis ----------------------------------------
<FilesMatch "^(config\.php|composer\.(json|lock)|\.gitignore|README\.md)$">
    Require all denied
</FilesMatch>

# Bloqueia acesso a diretórios internos via web (defesa em profundidade)
RewriteRule ^(app|config|database|routes|storage)/ - [F,L]
